<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust </title>
</head>
<body>
    <h1>Showing all info of id : <%= listing._id%> </h1>
       <ul>
        <li><%= listing.title %></li>
        <li><%= listing.description %></li>
        <li>&#8377;<%= listing.price.toLocaleString("en-IN") %></li>  <!-- toLocalString("en-IN")  is a function used to set " , " in price -->
        <li><%= listing.location %></li>
        <li><%= listing.country %></li>
       </ul>
</body>
</html>
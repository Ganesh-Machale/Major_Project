<% layout('/layouts/boilerplate') -%>
<body>
    <h1>Listings Details </h1>

      <div class="card">
              <img class="card-img-top show-img" src="<%= listing.image %>" alt="Card image cap">
              <div class="card-body">
             <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
         </div>
      </div> 

       <ul>
        <li><%= listing.title %></li>
        <li><%= listing.description %></li>
        <li>&#8377;<%= listing.price.toLocaleString("en-IN") %></li>  <!-- toLocalString("en-IN")  is a function used to set " , " in price -->
        <li><%= listing.location %></li>
        <li><%= listing.country %></li>
       </ul>
       <br>
       <button><a href="/listing/<%= listing._id %>/edit">Edit listing</a></button> 
       <br><br>
       <form  method="post" action="/listing/<%= listing._id %>?_method=Delete">
          <button>Delete listing</button>
       </form>
</body>

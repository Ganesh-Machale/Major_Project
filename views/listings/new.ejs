<% layout('/layouts/boilerplate') -%>
<body>
    <div class="row">
     <div class="col-8 offset-2">
        <br><br>
    <h3>Create new Listing</h3>
    <form  method="post" action="/listing"  class="needs-validation" novalidate>
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
             <input type="text" class="form-control" name="listing[title]" placeholder="Enter Title" required ></input>
              <div class="valid-feedback">
                Title looks good!
               </div>
        </div>
       

        <div class="mb-3">
            <label for="Describtion" class="form-label">Description</label>
            <textarea type="text" class="form-control" name="listing[description]" placeholder="Enter Description" required></textarea>
             <div class="invalid-feedback">
                Please enter the short Description
               </div>
        </div>
       

        <div class="mb-3">
            <label for="image" class="form-label">Image link</label>
            <input type="text" name="listing[image]" class="form-control" placeholder="Enter image URL/link"></input>
        </div>
        
        <div class="row">
        <div class="mb-3 col-4">
             <label for="price" class="form-label">Price</label>
             <input type="text" name="listing[price]" class="form-control" placeholder="Enter Price" required ></input>
             <div class="invalid-feedback">Price Should be Valid</div>
        </div>
        
        <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input type="text" name="listing[country]" class="form-control" placeholder="Enter country" required></input>
            
        </div>
        </div>

        <div class="mb-3">
              <label for="location" class="form-label">Location</label>
              <input type="text" name="listing[location]" class="form-control" placeholder="Enter location" required></input>
              <div class="invalid-feedback">Location Should be Valid</div>
        </div>
        <br>

        <button class="btn btn-dark add-btn">Add</button>
                <br><br>

    </form>
</body>
</div>
</div>


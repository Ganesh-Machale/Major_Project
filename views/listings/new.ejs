<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>
<body>
    <form method="post" action="/listing">
        <input type="text" name="title" placeholder="Enter your title" ></input><br>
       <textarea type="text" name="description" placeholder="Enter Description"></textarea><br>
        <input type="text" name="price" placeholder="Enter Price"></input><br>
        <input type="text" name="location" placeholder="Enter location"></input><br>
        <input type="text" name="country" placeholder="Enter country"></input><br>

        <button>Add</button>
    </form>
</body>
</html>
<% layout('/layouts/boilerplate') -%>
<body>
    <h1>Edit the info</h1>
    <form method="post" action="/listing/<%= listing._id %>?_method=PUT">
    <div class="mb-3">
         <label for="title" class="form-label">Title</label>
        <input type="text" name="listing[title]" value="<%= listing.title %>" />
    </div>
        <br><br>

         <div class="mb-3">
             <label for="Describtion" class="form-label">Description</label>
            <textarea type="text" name="listing[description]" ><%= listing.description %> </textarea>
         </div>
       <br><br>

       <div class="mb-3">
            <label for="image" class="form-label">Image link</label>
            <input type="text" name="listing[image]" value="<%= listing.image %>" />
       </div>
        <br><br>

        <div class="mb-3">
            <label for="price" class="form-label">Price</label>
            <input type="text" name="listing[price]" value="<%= listing.price %>" />  
        </div>
        <br><br>

        <div class="mb-3">
             <label for="country" class="form-label">Country</label>
            <input type="text" name="listing[country]" value="<%= listing.country %>" />
        </div>
         <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" value="<%= listing.location %>" />
         </div>
        <br><br>

        <button>Edit</button>
    </form>
</body>

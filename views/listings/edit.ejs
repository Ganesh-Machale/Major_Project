<% layout('/layouts/boilerplate') -%>
<body>
    <h1>Edit the info</h1>
    <form method="post" action="/listing/<%= listing._id %>?_method=PUT">
        <input type="text" name="listing[title]" value="<%= listing.title %>" />
        <br><br>
       <textarea type="text" name="listing[description]" ><%= listing.description %> </textarea>
       <br><br>
        <input type="text" name="listing[image]" value="<%= listing.image %>" />
        <br><br>
        <input type="text" name="listing[price]" value="<%= listing.price %>" />
        <br><br>
        <input type="text" name="listing[location]" value="<%= listing.location %>" />
        <br><br>
        <input type="text" name="listing[country]" value="<%= listing.country %>" />
        <br><br>

        <button>Edit</button>
    </form>
</body>
